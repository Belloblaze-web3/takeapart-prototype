# Server-only Meta Model API key. Never use a VITE_ prefix for this secret.
MODEL_API_KEY=

# Optional comma-separated allowed browser origins. The existing TakeApart Render site and local development are allowed by default.
APP_ORIGINS=

# Optional public API origin for the static frontend after an explicitly approved API deployment.
# Leave blank in this code-only project until an API service exists.
VITE_META_API_ORIGIN=
